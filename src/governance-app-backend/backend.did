// HTTP
type HeaderField = record { text; text };

type HttpRequest = record {
    method : text;
    url : text;
    headers : vec HeaderField;
    body : blob;
    certificate_version : opt nat16
};

type HttpResponse = record {
    status_code : nat16;
    headers : vec HeaderField;
    body : blob;
    // If true, the HTTP gateway sends the request again to `http_request_update`.
    upgrade : opt bool
};

type HttpUpdateRequest = record {
    method : text;
    url : text;
    headers : vec HeaderField;
    body : blob
};

type HttpUpdateResponse = record {
    status_code : nat16;
    headers : vec HeaderField;
    body : blob
};
// End HTTP

// Address Book
type AddressType = variant {
    Icp : text;
    Icrc1 : text;
};

type NamedAddress = record {
    address : AddressType;
    name : text;
};

type AddressBook = record {
    named_addresses : vec NamedAddress;
};

type SetAddressBookResponse = variant {
    Ok;
    AnonymousNotAllowed;
    TooManyNamedAddresses : record { limit : int32 };
    InvalidIcpAddress : record { error : text };
    AddressNameTooShort : record { min_length : int32 };
    AddressNameTooLong : record { max_length : int32 };
    InvalidIcrc1Address : record { error : text };
    DuplicateAddressName : record { name : text };
};

type GetAddressBookResponse = variant {
    Ok : AddressBook;
    AnonymousNotAllowed;
};
// End Address Book

// Exchange Rate
type CachedRate = record {
    rate_e8s : nat64;
    // When the exchange rate canister (XRC) observed this rate.
    timestamp_seconds : nat64;
    // When our canister last wrote this entry to the cache.
    updated_at_seconds : nat64;
};

type IcpExchangeRateResponse = record {
    current : opt CachedRate;
    one_day_ago : opt CachedRate;
};

// The ICP/USD rate at the start of a two-hour slot.
// For example, a `rate_e8s` of 264_000_000 means that 1 ICP buys 2.64 USD.
type PastMonthRate = record {
    rate_e8s : nat64;
    timestamp_seconds : nat64;
};

// Units of `symbol` for one USD.
// For example, a `rate_e8s` of 314_000_000 for "XYZ" means that 1 USD buys 3.14 XYZ.
type FiatExchangeRate = record {
    // ISO 4217 currency code, e.g. "EUR".
    symbol : text;
    rate : opt CachedRate;
};

// The rates at 00:00 UTC of one day.
type DailyRate = record {
    // 00:00 UTC of the day.
    timestamp_seconds : nat64;
    // For example, 264_000_000 means that 1 ICP buys 2.64 USD.
    icp_to_usd_e8s : opt nat64;
    // Units of the requested fiat currency for one USD.
    // For example, 92_000_000 for "EUR" means that 1 USD buys 0.92 EUR.
    // For a day in the last 3 days, the XRC can still change the rate. Thus the rate of such a
    // day is the newest non-final rate, and it can be the rate of an earlier day.
    usd_to_fiat_e8s : opt nat64;
    // true if `usd_to_fiat_e8s` is the final rate of the day.
    // false if it is a non-final rate, or if `usd_to_fiat_e8s` is empty.
    usd_to_fiat_is_final : bool;
};

type ListDailyExchangeRatesRequest = record {
    // The list includes each day whose 00:00 UTC is at or after this time.
    from_timestamp_seconds : nat64;
    // The list includes each day whose 00:00 UTC is before this time.
    to_timestamp_seconds : nat64;
    // ISO 4217 currency code, e.g. "EUR". Without it, the list has only the ICP/USD rates.
    fiat_symbol : opt text;
};

type ListDailyExchangeRatesResponse = variant {
    Ok : vec DailyRate;
    UnsupportedFiatSymbol : record { symbol : text };
};
// End Exchange Rate

service : {
    // HTTP
    http_request : (request : HttpRequest) -> (HttpResponse) query;
    // Serves the proposal pages with link preview tags. The HTTP gateway calls it if
    // `http_request` returns `upgrade = opt true`.
    http_request_update : (request : HttpUpdateRequest) -> (HttpUpdateResponse);
    // End HTTP

    // Address Book
    get_address_book : () -> (GetAddressBookResponse) query;
    set_address_book : (AddressBook) -> (SetAddressBookResponse);
    // End Address Book

    // Exchange Rate
    get_icp_to_usd_exchange_rate : () -> (IcpExchangeRateResponse) query;
    // The one-day-ago rate, then the newer rates of the last day, oldest first.
    get_icp_to_usd_rate_history : () -> (vec CachedRate) query;
    // The rates of the last 30 days, oldest first. Slots without a rate have no entry.
    list_icp_to_usd_past_month_rates : () -> (vec PastMonthRate) query;
    list_usd_to_fiat_exchange_rates : () -> (vec FiatExchangeRate) query;
    // The rates of the requested days, oldest first. Days without a rate have no entry.
    // The history starts on 1 January 2025.
    list_daily_exchange_rates : (ListDailyExchangeRatesRequest) -> (ListDailyExchangeRatesResponse) query;
    // End Exchange Rate
}
